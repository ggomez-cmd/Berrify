# Public — safe to expose to the Vite client
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_DEMO_EMAIL=demo@berrify.local
NEXT_PUBLIC_DEMO_STAFF_EMAIL=server@berrify.local
NEXT_PUBLIC_DEMO_PASSWORD=12345678

# Server-only — used by scripts/ (never imported from src/)
SUPABASE_SERVICE_ROLE_KEY=
DIRECT_URL=
DATABASE_URL=
# Optional. Management API token for `npm run auth:email-templates`
# https://supabase.com/dashboard/account/tokens
# SUPABASE_ACCESS_TOKEN=

# Optional overrides for seed
DEMO_EMAIL=demo@berrify.local
DEMO_PASSWORD=12345678

# Optional Worker public origin for QBWC AppURL and QuickBooks Online redirect
# (defaults to https://berrify.app). Redirect URL is {PUBLIC_APP_URL}/api/qbo/callback.
# PUBLIC_APP_URL=https://berrify.app

# QuickBooks Online Worker secrets. Set with `wrangler secret put`. Do not commit values.
# INTUIT_CLIENT_ID=
# INTUIT_CLIENT_SECRET=
# INTUIT_ENVIRONMENT=sandbox

# Cloudflare Workers (wrangler / GitHub Actions — never imported from src/)
# CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_ACCOUNT_ID=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ORG_ID=
# GEMINI_API_KEY=  # Worker secret only. Never import from src/.
